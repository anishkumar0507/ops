# ──────────────────────────────────────────────────────────────
#  OpsBot v3 — Environment Variables (EXAMPLE / TEMPLATE)
#  Copy this file to .env and fill in your real values.
#  This file is safe to commit. .env is gitignored.
# ──────────────────────────────────────────────────────────────

# Firebase Project Config
# Get from: Firebase Console → Project Settings → Your Apps → Web → Config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Claude (Anthropic) API Key
# Get from: https://console.anthropic.com → API Keys
CLAUDE_API_KEY=

# Server Port (optional, defaults to 3000)
PORT=3000
